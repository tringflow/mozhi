SARVAM_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never prefix with NEXT_PUBLIC_). Required for audio uploads: the server needs it
# to mint signed Storage URLs, and it is the default secret for signing upload paths. Also makes
# API routes bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Only needed if you run WITHOUT a service-role key; any long random string.
UPLOAD_SIGNING_SECRET=
# Server-only. Required for the abandoned-upload cleanup cron; at least 16 random characters.
# On Vercel this is sent automatically as "Authorization: Bearer <value>". Without it the
# cleanup route refuses to run.
CRON_SECRET=
# Server-only, optional. Hours an unreferenced upload survives before cleanup (default 24).
# Clamped to a 4-hour floor, so it can never collect an upload that is still usable.
ORPHAN_GRACE_HOURS=
