SARVAM_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never prefix with NEXT_PUBLIC_). Required for audio uploads: the server needs it
# to mint signed Storage URLs, and it is the default secret for signing upload paths. Also makes
# API routes bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Only needed if you run WITHOUT a service-role key; any long random string.
UPLOAD_SIGNING_SECRET=
